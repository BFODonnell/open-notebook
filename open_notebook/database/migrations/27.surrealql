DEFINE TABLE db_catalog SCHEMAFULL;
DEFINE FIELD payload ON db_catalog FLEXIBLE TYPE object;
DEFINE TABLE db_resource SCHEMAFULL;
DEFINE FIELD payload ON db_resource FLEXIBLE TYPE object;
DEFINE TABLE db_catalog_cache SCHEMAFULL;
DEFINE FIELD payload ON db_catalog_cache FLEXIBLE TYPE object;
DEFINE FIELD expires_at ON db_catalog_cache TYPE datetime;
DEFINE TABLE db_import SCHEMAFULL;
DEFINE FIELD payload ON db_import FLEXIBLE TYPE object;
DEFINE FIELD notebook_id ON db_import TYPE string;
DEFINE FIELD resource_id ON db_import TYPE string;
DEFINE FIELD version_id ON db_import TYPE string;
DEFINE FIELD status ON db_import TYPE string;
DEFINE FIELD stage ON db_import TYPE string;
DEFINE FIELD lease_until ON db_import TYPE string;
DEFINE FIELD cancel_requested ON db_import TYPE bool DEFAULT false;
DEFINE FIELD run_token ON db_import TYPE option<string>;
DEFINE FIELD command_id ON db_import TYPE option<string>;
DEFINE FIELD created ON db_catalog TYPE option<datetime>;
DEFINE FIELD updated ON db_catalog TYPE option<datetime>;
DEFINE FIELD created ON db_resource TYPE option<datetime>;
DEFINE FIELD updated ON db_resource TYPE option<datetime>;
DEFINE INDEX import_notebook ON db_import FIELDS notebook_id;
