# Copy to .env.databridge (ignored by git). Use independent random secrets.
# PostgreSQL password must be URL-safe (for example 32 random hex bytes).
SURREAL_PASSWORD=
LITELLM_POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=sk-
LITELLM_SALT_KEY=
LITELLM_APP_VIRTUAL_KEY=sk-
LITELLM_APP_MAX_BUDGET=20
OPEN_NOTEBOOK_ENCRYPTION_KEY=
OPEN_NOTEBOOK_PASSWORD=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-6-astra
LLM_PROVIDER_MODEL=openai/gpt-6-astra
# Optional reviewed pricing in USD PER TOKEN, both or neither. Never guess.
LLM_INPUT_COST_PER_TOKEN=
LLM_OUTPUT_COST_PER_TOKEN=
