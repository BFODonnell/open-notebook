FROM ghcr.io/astral-sh/uv:0.8.3-python3.12-bookworm-slim@sha256:74b8fe8ec5931f3930cfb6c87b46aeb1dbd497a609f6abf860fd0f4390f8b040
WORKDIR /opt/broker
COPY deployment/databridge/mcp/pyproject.toml deployment/databridge/mcp/uv.lock ./
RUN uv sync --frozen
COPY scripts/databridge_p0/motherduck/pyproject.toml scripts/databridge_p0/motherduck/uv.lock /opt/motherduck/
RUN uv sync --project /opt/motherduck --frozen
COPY open_notebook/databridge/mcp/policy.py open_notebook/databridge/mcp/versions.py ./open_notebook/databridge/mcp/
COPY deployment/databridge/mcp/broker.py ./broker.py
COPY deployment/databridge/mcp/toolbox_proxy.py ./toolbox_proxy.py
ENV PATH=/opt/broker/.venv/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV HOME=/tmp
USER 65532:65532
CMD ["python", "broker.py"]
