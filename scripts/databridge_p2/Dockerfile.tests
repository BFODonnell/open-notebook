FROM ghcr.io/astral-sh/uv:0.8.3-python3.12-bookworm-slim@sha256:74b8fe8ec5931f3930cfb6c87b46aeb1dbd497a609f6abf860fd0f4390f8b040
WORKDIR /app
COPY pyproject.toml uv.lock mypy.ini ./
RUN uv sync --frozen --extra databridge --no-install-project
ENV PATH="/app/.venv/bin:${PATH}"
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "5055"]
