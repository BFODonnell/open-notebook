# Open Notebook DataBridge -- REFERENCE ONLY; copy to repository's real .env once Codex integrates.
# All values here are examples. NEVER commit the populated .env or use demo keys in production.

# Open Notebook upstream: keep its own SURREAL_*, OPEN_NOTEBOOK_ENCRYPTION_KEY,
# OPEN_NOTEBOOK_PASSWORD and other variables from the checked-out .env.example.

# Model default, routing through LiteLLM Proxy via upstream Esperanto/OpenAI-Compatible provider.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-astra
LLM_PROVIDER_MODEL=openai/gpt-6-astra
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=REPLACE_WITH_PROVIDER_API_KEY

# Server-side LiteLLM credentials. MASTER never exposed to browser or used as routine app key.
LITELLM_PROXY_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-REPLACE_WITH_LONG_RANDOM_ADMIN_SECRET
LITELLM_SALT_KEY=sk-REPLACE_WITH_STABLE_RANDOM_ENCRYPTION_SECRET
LITELLM_APP_VIRTUAL_KEY=sk-REPLACE_WITH_BOOTSTRAPPED_APP_VIRTUAL_KEY
LITELLM_POSTGRES_USER=litellm
LITELLM_POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_POSTGRES_PASSWORD
LITELLM_POSTGRES_DB=litellm
USAGE_TRACKING_ENABLED=true
USAGE_CURRENCY=USD
USAGE_BUDGET_USD=25

# Data.gov v4 API; DEMO_KEY only valid for very limited manual experimentation.
DATAGOV_BASE_URL=https://api.gsa.gov/technology/datagov/v4
DATAGOV_API_KEY=REPLACE_WITH_GSA_DATAGOV_API_KEY
DATAGOV_REQUEST_TIMEOUT_S=20
DATAGOV_CACHE_TTL_S=3600

# Ingestion and security caps: tune after measuring NTD distribution and local disk.
IMPORT_MAX_DOWNLOAD_MB=250
IMPORT_MAX_EXPANDED_MB=500
IMPORT_MAX_ZIP_ENTRIES=200
IMPORT_MAX_ROWS=5000000
IMPORT_TIMEOUT_S=600
IMPORT_STAGING_DIR=/data/databridge/staging
DUCKDB_DATA_DIR=/data/databridge/duckdb
QUERY_MAX_ROWS=1000
QUERY_TIMEOUT_S=30
QUERY_APPROVAL_REQUIRED=true
DATAGOV_ALLOW_PUBLISHER_HOSTS=data.transportation.gov,api.census.gov,www.ncei.noaa.gov

# MCP internal service endpoints (confirm exact path against pinned releases).
DBHUB_MCP_URL=http://dbhub-mcp:8080/mcp
DUCKDB_MCP_URL=http://duckdb-mcp:8000/mcp
GOOGLE_TOOLBOX_MCP_URL=http://google-toolbox:5000/mcp

# Compose reference needs pinned images supplied by Codex after upstream audit.
LITELLM_IMAGE=ghcr.io/berriai/litellm:REPLACE_WITH_PINNED_VERSION
DBHUB_IMAGE=REPLACE_WITH_VERIFIED_PINNED_DBHUB_IMAGE
DUCKDB_MCP_IMAGE=REPLACE_WITH_VERIFIED_PINNED_DUCKDB_MCP_IMAGE
TOOLBOX_IMAGE=REPLACE_WITH_VERIFIED_PINNED_TOOLBOX_IMAGE

# API keys for public data companion sources if needed by selected endpoint.
CENSUS_API_KEY=REPLACE_WITH_CENSUS_API_KEY_IF_REQUIRED
NOAA_API_KEY=

# Demo: strict public data/synthetic fixtures only; no internal agency data.
DATABRIDGE_DEMO_MODE=true
