{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataBridge UsageSummary",
  "type": "object",
  "required": [
    "request_count",
    "input_tokens",
    "output_tokens",
    "pricing_status"
  ],
  "properties": {
    "request_count": {
      "type": "integer",
      "minimum": 0
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cached_input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "estimated_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "pricing_status": {
      "enum": [
        "priced",
        "estimated",
        "unpriced",
        "mixed"
      ]
    },
    "model_breakdown": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
