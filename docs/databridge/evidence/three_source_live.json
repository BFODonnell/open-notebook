      },
      "provenance": {
        "contract": {
          "geography": "NTD agency State MA maps to Census STATE 25, SUMLEV 040. Logan USW00014739 is a coastal Boston station, not a statewide weather estimate or an agency service-area exposure.",
          "grain": "Only Annual Total NTD rows. Require unique year/NTD ID/mode/type-of-service keys; sum once per year before attaching one population and one station record. UPT counts boardings, not unique people. Agency-headquarters state does not imply all trips occurred in that state.",
          "join": "One row per report year, left join annual population and station by year; reject duplicate keys; absent years remain NULL. Never repeat population across transit rows.",
          "missing": "TRY_CAST comma-stripped UPT; retain missing and questionable counts. Per-resident ratio withheld if any UPT is missing/questionable. Weather NULLs stay missing; flagged precipitation withheld. Annual source/measurement flags do not certify daily completeness.",
          "time": "2022–2025 year labels: NTD annual agency report year (fiscal periods may differ), Census July 1 resident population (Vintage 2025), NOAA calendar-year summary. Descriptive contextual comparison only; no exact temporal exposure match or causal inference.",
          "version": "ma-logan-annual-v1"
        },
        "sources": {
          "population": "dc0d489d-bfa0-471d-ad52-aeff0c5cf198",
          "transit": "54b66fa6-f5ac-40d7-84d9-2cb288ebd5ba",
          "weather": "32e5f499-ae76-470b-9b98-1b820aa3c5aa"
        },
        "reviewed_queries": [
          {
            "name": "transit",
            "role": "transit",
            "sql": "SELECT \"c_7_report_year\" AS \"report_year\", COUNT(*) AS \"records\", SUM(TRY_CAST(REPLACE(\"c_51_unlinked_passenger_trips__upt\", ',', '') AS BIGINT)) AS \"reported_trips\", SUM(CASE WHEN TRY_CAST(REPLACE(\"c_51_unlinked_passenger_trips__upt\", ',', '') AS BIGINT) IS NULL THEN 1 ELSE 0 END) AS \"missing_trips\", SUM(CASE WHEN COALESCE(\"c_52_unlinked_passenger_trips_questionable\", '') <> '' THEN 1 ELSE 0 END) AS \"questionable_trips\" FROM \"data\" WHERE \"c_3_state\" = 'MA' AND \"c_20_time_period\" = 'Annual Total' AND \"c_7_report_year\" BETWEEN 2022 AND 2025 GROUP BY \"c_7_report_year\" ORDER BY \"c_7_report_year\" LIMIT 100"
          },
          {
            "name": "grain_2022",
            "role": "transit",
            "sql": "SELECT \"c_4_ntd_id\", \"c_9_mode\", \"c_11_type_of_service\", COUNT(*) AS \"records\" FROM \"data\" WHERE \"c_3_state\" = 'MA' AND \"c_20_time_period\" = 'Annual Total' AND \"c_7_report_year\" BETWEEN 2022 AND 2025 AND \"c_7_report_year\" = 2022 GROUP BY \"c_4_ntd_id\", \"c_9_mode\", \"c_11_type_of_service\" LIMIT 100"
          },
          {
            "name": "grain_2023",
            "role": "transit",
            "sql": "SELECT \"c_4_ntd_id\", \"c_9_mode\", \"c_11_type_of_service\", COUNT(*) AS \"records\" FROM \"data\" WHERE \"c_3_state\" = 'MA' AND \"c_20_time_period\" = 'Annual Total' AND \"c_7_report_year\" BETWEEN 2022 AND 2025 AND \"c_7_report_year\" = 2023 GROUP BY \"c_4_ntd_id\", \"c_9_mode\", \"c_11_type_of_service\" LIMIT 100"
          },
          {
            "name": "grain_2024",
            "role": "transit",
            "sql": "SELECT \"c_4_ntd_id\", \"c_9_mode\", \"c_11_type_of_service\", COUNT(*) AS \"records\" FROM \"data\" WHERE \"c_3_state\" = 'MA' AND \"c_20_time_period\" = 'Annual Total' AND \"c_7_report_year\" BETWEEN 2022 AND 2025 AND \"c_7_report_year\" = 2024 GROUP BY \"c_4_ntd_id\", \"c_9_mode\", \"c_11_type_of_service\" LIMIT 100"
          },
          {
            "name": "grain_2025",
            "role": "transit",
            "sql": "SELECT \"c_4_ntd_id\", \"c_9_mode\", \"c_11_type_of_service\", COUNT(*) AS \"records\" FROM \"data\" WHERE \"c_3_state\" = 'MA' AND \"c_20_time_period\" = 'Annual Total' AND \"c_7_report_year\" BETWEEN 2022 AND 2025 AND \"c_7_report_year\" = 2025 GROUP BY \"c_4_ntd_id\", \"c_9_mode\", \"c_11_type_of_service\" LIMIT 100"
          },
          {
            "name": "population",
            "role": "population",
            "sql": "SELECT \"c_9_popestimate2022\" AS \"pop_2022\", \"c_10_popestimate2023\" AS \"pop_2023\", \"c_11_popestimate2024\" AS \"pop_2024\", \"c_12_popestimate2025\" AS \"pop_2025\" FROM \"data\" WHERE \"c_1_sumlev\" = '040' AND \"c_4_state\" = '25' LIMIT 100"
          },
          {
            "name": "weather",
            "role": "weather",
            "sql": "SELECT \"c_1_station\" AS \"station\", \"c_6_date\" AS \"report_year\", \"c_9_tavg\" AS \"tavg\", \"c_7_prcp\" AS \"prcp\", \"c_10_tavg_attributes\" AS \"tavg_flags\", \"c_8_prcp_attributes\" AS \"prcp_flags\" FROM \"data\" WHERE \"c_1_station\" = 'USW00014739' AND \"c_6_date\" BETWEEN 2022 AND 2025 ORDER BY \"c_6_date\" LIMIT 100"
          }
        ]
      }
    },
