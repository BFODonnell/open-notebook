    "sql": "SELECT \"c_4_report_year\" AS \"report_year\", \"c_5_reported_trips\" AS \"reported_passenger_trips\", \"c_2_questionable_trips\" AS \"questionable_trip_record_count\", \"c_7_population_july1\" AS \"population_july1\", \"c_10_logan_tavg_c\" AS \"logan_average_temperature_c\", \"c_11_logan_prcp_mm\" AS \"logan_precipitation_mm\", \"c_1_missing_trips\" AS \"missing_trip_record_count\", \"c_3_records\" AS \"transit_record_count\", \"c_8_population_vintage\" AS \"population_vintage\", \"c_6_state_fips\" AS \"state_fips\", \"c_12_weather_station\" AS \"weather_station\", \"c_13_tavg_source_flag\" AS \"temperature_source_flag\", \"c_14_prcp_measurement_source_flags\" AS \"precipitation_measurement_source_flags\", \"c_15_weather_annual_record_available\" AS \"weather_annual_record_available\" FROM \"data\" WHERE \"c_4_report_year\" >= 2022 AND \"c_4_report_year\" <= 2025 ORDER BY \"c_4_report_year\" LIMIT 100",
